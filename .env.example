# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# PORT: The server port (defaults to 3000)
PORT=3000

# SESSION_SECRET: Secret for signing tokens and audit logs
SESSION_SECRET="zoo-sentinel-production-secret-token"

# TWILIO CONFIGURATION (Optional - for real emergency SMS dispatch)
# When configured, real emergency SMS alerts will be transmitted via Twilio REST API.
# When missing, Zoo Sentinel clearly reports "SMS provider not configured".
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
